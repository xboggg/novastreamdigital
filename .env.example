# NovaStream Digital Environment Variables
# Copy this to .env and fill in the actual values
# NEVER commit .env to git!

# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# hCaptcha Configuration (get from https://www.hcaptcha.com/)
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Webhook Configuration (for server-side deployment webhook)
# Set this on your server as environment variable
WEBHOOK_SECRET=generate-a-strong-random-secret
WEBHOOK_PORT=9456
